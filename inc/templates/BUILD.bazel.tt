# BUILD.bazel generated by BUILD.bazel.PL

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_proto//proto:defs.bzl", "proto_library")
# Assuming rules_perl is available
# load("@rules_perl//perl:defs.bzl", "perl_library", "perl_test")

package(default_visibility = ["//visibility:public"])

# Libraries
# =============================================================================

cc_library(
    name = "libprotobufperl",
    srcs = [
[% INCLUDE bazel_src_list.tt files = common_c_files %]
    ],
    hdrs = glob([
        "xs/**/*.h",
    ]),
    copts = [
        "-I.",
        "-Iperl",
        "-I[% Config.archlibexp %]/CORE",
        "-D_GNU_SOURCE",
        "-Wno-error=attributes",
        "-fPIC",
    ] + select({
        "//conditions:default": [],
[% IF USE_ASAN %]        "//conditions:asan": ["-fsanitize=address"],
[% END %][% IF USE_UBSAN %]        "//conditions:ubsan": ["-fsanitize=undefined"],
[% END %][% IF USE_MSAN %]        "//conditions:msan": ["-fsanitize=memory"],
[% END %][% IF USE_TSAN %]        "//conditions:tsan": ["-fsanitize=thread"],
[% END %]
    }),
    linkopts = [
[% IF USE_ASAN %]        "-fsanitize=address",
[% END %][% IF USE_UBSAN %]        "-fsanitize=undefined",
[% END %][% IF USE_MSAN %]        "-fsanitize=memory",
[% END %][% IF USE_TSAN %]        "-fsanitize=thread",
[% END %]
    ],
    deps = [
        "@abseil-cpp//absl/base",
        "//upb/base",
        "//upb/mem",
        "//upb/message",
        "//upb/mini_descriptor",
        "//upb/mini_table",
        "//upb/reflection",
        "//upb/wire",
        "//third_party/utf8_range",
        # Add other necessary deps
    ],
    alwayslink = 1,
)

# Binaries
# =============================================================================

cc_binary(
    name = "protoc-gen-perl-pb",
    srcs = ["protoc/protoc-gen-perl-pb.cc"],
    deps = [
        "//:protobuf",
        "//src/google/protobuf:descriptor_upb_c_proto",
        "//src/google/protobuf/compiler:plugin_upb_c_proto",
        "//upb/base",
        "//upb/mem",
        "//upb/reflection",
    ],
)

# C Test Infrastructure
# =============================================================================

cc_library(
    name = "upb_perl_test_lib",
    srcs = ["t/c/upb-perl-test.c"],
    hdrs = ["t/c/upb-perl-test.h"],
    copts = [
        "-I.",
        "-Iexternal/upb",
        "-I[% Config.archlibexp %]/CORE",
    ],
    deps = [":libprotobufperl"],
)

genrule(
    name = "test_descriptor_bin",
    srcs = [
        "t/c/test.proto",
        "@com_google_protobuf//:descriptor_proto",
    ],
    outs = ["t/data/test_descriptor.bin"],
    cmd = "$(execpath @com_google_protobuf//:protoc) --descriptor_set_out=$@ --include_imports --proto_path=t/c --proto_path=$(rootpath @com_google_protobuf//:descriptor_proto)/.. $(location t/c/test.proto)",
    tools = ["@com_google_protobuf//:protoc"],
)

# C Tests
[% FOREACH test IN c_tests %]
[% INCLUDE bazel_c_test.tt test %]
[% END %]

# C Benchmarks
[% FOREACH bench IN c_benchmarks %]
[% INCLUDE bazel_c_bench.tt bench %]
[% END %]

# Test Suites
# =============================================================================
test_suite(
    name = "c_tests",
    tests = [
        [% FOREACH t IN c_test_targets %]
        "[% t %]",
        [% END %]
    ],
)

# Perl tests would be defined here if @rules_perl is set up
